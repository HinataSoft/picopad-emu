# cmake -P: builds every game of PicoLibSDK (tools/coverage) with `ninja -k 0`,
# runs each built exe headless with smoke.txt and writes <OUT>/summary.md.
#   -DPICOLIBSDK_DIR=<PicoLibSDK> -DOUT=<dir>
#   [-DPYTHON=<python>]                 for png_decode.py --colors (default: C:/Progs/anaconda3/python.exe)
#   [-DTOOLCHAIN_FILE=...] [-DPICOPAD_TOOLCHAIN_DIR=...] [-DGENERATOR=Ninja]
# Exit code 0 when every game passes (built, exit code 0, "end reason=quit",
# screenshot with >= 2 colours), otherwise 1. Layout of OUT: build/ (the
# external project), run/<game>/ (cwd of a run), shots/<game>.png, summary.md.
if(NOT DEFINED PICOLIBSDK_DIR OR NOT DEFINED OUT)
    message(FATAL_ERROR "usage: cmake -DPICOLIBSDK_DIR=... -DOUT=<dir> -P run.cmake")
endif()
get_filename_component(_here "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
get_filename_component(EMU_DIR "${_here}/../.." ABSOLUTE)
get_filename_component(OUT "${OUT}" ABSOLUTE)
if(NOT TOOLCHAIN_FILE)
    set(TOOLCHAIN_FILE "${EMU_DIR}/cmake/toolchain-mingw32.cmake")
endif()
if(NOT GENERATOR)
    set(GENERATOR Ninja)
endif()
if(NOT PYTHON)
    set(PYTHON "C:/Progs/anaconda3/python.exe")
endif()
set(_bd "${OUT}/build")
file(REMOVE_RECURSE "${OUT}/run" "${OUT}/shots" "${OUT}/summary.md")
file(MAKE_DIRECTORY "${OUT}/shots" "${_bd}")

set(_fwd "-DPICOLIBSDK_DIR=${PICOLIBSDK_DIR}")
if(PICOPAD_TOOLCHAIN_DIR)
    list(APPEND _fwd "-DPICOPAD_TOOLCHAIN_DIR=${PICOPAD_TOOLCHAIN_DIR}")
endif()
execute_process(COMMAND ${CMAKE_COMMAND} -S "${_here}" -B "${_bd}" -G "${GENERATOR}"
                        "-DCMAKE_TOOLCHAIN_FILE=${TOOLCHAIN_FILE}" "-DPICOPAD_EMU_DIR=${EMU_DIR}"
                        -DCMAKE_BUILD_TYPE=Debug ${_fwd}
                RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "configure of tools/coverage failed (${_rc})")
endif()

# -k 0: a failing game does not stop the others; the exit code is not checked,
# a missing exe is reported as build=FAIL
execute_process(COMMAND ${CMAKE_COMMAND} --build "${_bd}" -- -k 0 RESULT_VARIABLE _brc)
message(STATUS "build finished with code ${_brc}")

file(STRINGS "${_bd}/games.txt" _games)
set(_rows "")
set(_total 0)
set(_built 0)
set(_ran 0)
set(_nonuni 0)
set(_pass 0)
foreach(_g IN LISTS _games)
    if(_g STREQUAL "")
        continue()
    endif()
    math(EXPR _total "${_total} + 1")
    set(_b FAIL)
    set(_code "-")
    set(_end "-")
    set(_cols "-")
    set(_ok 0)
    if(EXISTS "${_bd}/${_g}.exe")
        set(_b ok)
        math(EXPR _built "${_built} + 1")
        set(_wd "${OUT}/run/${_g}")
        file(MAKE_DIRECTORY "${_wd}")
        execute_process(COMMAND "${_bd}/${_g}.exe" --headless --script "${_here}/smoke.txt"
                                --shot-dir "${_wd}"
                        WORKING_DIRECTORY "${_wd}"
                        RESULT_VARIABLE _code OUTPUT_VARIABLE _out ERROR_VARIABLE _err
                        TIMEOUT 30)
        string(REPLACE "\r" "" _out "${_out}")
        string(REPLACE ";" "\;" _oe "${_out}")
        string(REPLACE "\n" ";" _lines "${_oe}")
        set(_end "(none)")
        foreach(_l IN LISTS _lines)
            if(_l MATCHES "^end ")
                set(_end "${_l}")
            endif()
        endforeach()
        if(_code STREQUAL "0" AND _end MATCHES "^end reason=quit ")
            math(EXPR _ran "${_ran} + 1")
        endif()
        if(EXISTS "${_wd}/smoke.png")
            file(COPY_FILE "${_wd}/smoke.png" "${OUT}/shots/${_g}.png")
            execute_process(COMMAND ${PYTHON} -I ${EMU_DIR}/tests/png_decode.py --colors "${OUT}/shots/${_g}.png"
                            RESULT_VARIABLE _crc OUTPUT_VARIABLE _cols)
            string(STRIP "${_cols}" _cols)
            if(NOT _crc EQUAL 0)
                set(_cols "error")
            elseif(_cols GREATER 1)
                math(EXPR _nonuni "${_nonuni} + 1")
                if(_code STREQUAL "0" AND _end MATCHES "^end reason=quit ")
                    set(_ok 1)
                endif()
            endif()
        endif()
        if(_err)
            message(STATUS "${_g} stderr: ${_err}")
        endif()
    endif()
    if(_ok)
        math(EXPR _pass "${_pass} + 1")
    endif()
    string(REPLACE "|" "/" _end "${_end}")
    string(APPEND _rows "| ${_g} | ${_b} | ${_code} | `${_end}` | ${_cols} |\n")
    message(STATUS "${_g}: build=${_b} code=${_code} colours=${_cols} ${_end}")
endforeach()

set(_sum "| hra | build | kód | end řádek | barev na snímku |\n|---|---|---|---|---|\n${_rows}\nbuilt=${_built} ran=${_ran} nonuniform=${_nonuni} total=${_total}\n")
file(WRITE "${OUT}/summary.md" "${_sum}")
message(STATUS "built=${_built} ran=${_ran} nonuniform=${_nonuni} total=${_total}")
if(NOT _pass EQUAL _total OR _total EQUAL 0)
    message(FATAL_ERROR "coverage: ${_pass} of ${_total} games pass, see ${OUT}/summary.md")
endif()
