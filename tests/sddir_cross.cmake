# cmake -P: images written by sddir_tool are read by the real lib_fat (picopad-sdimg), and
# images made by picopad-sdimg are read by the sddir reader (sddir_tool export).
#   -DTOOL=<sddir_tool> -DSDIMG=<picopad-sdimg> -DWORK_DIR=<dir, emptied at start>
if(NOT DEFINED TOOL OR NOT DEFINED SDIMG OR NOT DEFINED WORK_DIR)
    message(FATAL_ERROR "usage: cmake -DTOOL=... -DSDIMG=... -DWORK_DIR=... -P sddir_cross.cmake")
endif()

file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")

# run(<exe> <expected rc> <args...>) -> _out, _err
function(run exe expect)
    execute_process(COMMAND "${exe}" ${ARGN}
                    WORKING_DIRECTORY "${WORK_DIR}"
                    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 120)
    if(NOT "${_rc}" STREQUAL "${expect}")
        message(FATAL_ERROR "${exe} ${ARGN}: exit code '${_rc}', expected ${expect}\nstdout: ${_out}\nstderr: ${_err}")
    endif()
    set(_out "${_out}" PARENT_SCOPE)
    set(_err "${_err}" PARENT_SCOPE)
endfunction()

function(expect_same a b what)
    file(SHA256 "${a}" _ha)
    file(SHA256 "${b}" _hb)
    file(SIZE "${a}" _sa)
    file(SIZE "${b}" _sb)
    if(NOT _ha STREQUAL _hb OR NOT _sa EQUAL _sb)
        message(FATAL_ERROR "${what}: ${a} (${_sa} B) differs from ${b} (${_sb} B)")
    endif()
endfunction()

# 100 000 bytes of a pattern that differs from cluster to cluster (numbered blocks)
set(_pat "")
set(_i 0)
while(_i LESS 6300)
    string(LENGTH "${_i}" _l)
    math(EXPR _z "6 - ${_l}")
    string(SUBSTRING "000000" 0 ${_z} _pad)
    string(APPEND _pat "<blk${_pad}${_i}>-----")
    math(EXPR _i "${_i} + 1")
endwhile()
string(SUBSTRING "${_pat}" 0 100000 _pat)
string(LENGTH "${_pat}" _plen)
if(NOT _plen EQUAL 100000)
    message(FATAL_ERROR "pattern length ${_plen}")
endif()

set(SRC "${WORK_DIR}/src")
file(MAKE_DIRECTORY "${SRC}/DATA/SUB/EMPTY")
file(WRITE "${SRC}/DATA/A.TXT" "alpha")
file(WRITE "${SRC}/DATA/SUB/B.BIN" "${_pat}")
file(WRITE "${SRC}/DATA/SUB/ZERO.DAT" "")
file(WRITE "${SRC}/ROOT.TXT" "root")

# (a) sddir_tool build -> picopad-sdimg reads it
run("${TOOL}" 0 build "${SRC}" "${WORK_DIR}/a.img" --size 256)
file(SIZE "${WORK_DIR}/a.img" _isz)
if(NOT _isz EQUAL 268435456)
    message(FATAL_ERROR "a.img size ${_isz}, expected 268435456")
endif()
run("${SDIMG}" 0 ls "${WORK_DIR}/a.img" /)
if(NOT _out MATCHES "(^|\n)D DATA\r?\n" OR NOT _out MATCHES "(^|\n)F ROOT.TXT 4\r?\n")
    message(FATAL_ERROR "ls / : \n${_out}")
endif()
run("${SDIMG}" 0 ls "${WORK_DIR}/a.img" /DATA)
if(NOT _out MATCHES "(^|\n)F A.TXT 5\r?\n" OR NOT _out MATCHES "(^|\n)D SUB\r?\n")
    message(FATAL_ERROR "ls /DATA: \n${_out}")
endif()
run("${SDIMG}" 0 ls "${WORK_DIR}/a.img" /DATA/SUB)
if(NOT _out MATCHES "(^|\n)F B.BIN 100000\r?\n" OR NOT _out MATCHES "(^|\n)D EMPTY\r?\n"
   OR NOT _out MATCHES "(^|\n)F ZERO.DAT 0\r?\n")
    message(FATAL_ERROR "ls /DATA/SUB: \n${_out}")
endif()
run("${SDIMG}" 0 ls "${WORK_DIR}/a.img" /DATA/SUB/EMPTY)
foreach(_f DATA/A.TXT DATA/SUB/B.BIN DATA/SUB/ZERO.DAT ROOT.TXT)
    run("${SDIMG}" 0 get "${WORK_DIR}/a.img" "/${_f}" "${WORK_DIR}/a.get")
    expect_same("${SRC}/${_f}" "${WORK_DIR}/a.get" "get /${_f}")
    file(REMOVE "${WORK_DIR}/a.get")
endforeach()

# (b) picopad-sdimg create --from + put -> sddir_tool export
file(WRITE "${WORK_DIR}/extra.dat" "${_pat}${_pat}")
run("${SDIMG}" 0 create "${WORK_DIR}/b.img" --size 256 --from "${SRC}")
run("${SDIMG}" 0 put "${WORK_DIR}/b.img" /DATA/EXTRA.DAT "${WORK_DIR}/extra.dat")
run("${TOOL}" 0 export "${WORK_DIR}/b.img" "${WORK_DIR}/out")
file(GLOB_RECURSE _have LIST_DIRECTORIES true RELATIVE "${WORK_DIR}/out" "${WORK_DIR}/out/*")
file(GLOB_RECURSE _want LIST_DIRECTORIES true RELATIVE "${SRC}" "${SRC}/*")
list(APPEND _want "DATA/EXTRA.DAT")
string(TOUPPER "${_have}" _have)
string(TOUPPER "${_want}" _want)
list(SORT _have)
list(SORT _want)
if(NOT _have STREQUAL _want)
    message(FATAL_ERROR "exported tree differs:\nhave: ${_have}\nwant: ${_want}")
endif()
foreach(_f DATA/A.TXT DATA/SUB/B.BIN DATA/SUB/ZERO.DAT ROOT.TXT)
    expect_same("${SRC}/${_f}" "${WORK_DIR}/out/${_f}" "export ${_f}")
endforeach()
expect_same("${WORK_DIR}/extra.dat" "${WORK_DIR}/out/DATA/EXTRA.DAT" "export DATA/EXTRA.DAT")
message(STATUS "sddir_cross test OK")
